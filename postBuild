#!/usr/bin/env bash
set -e
echo "---- postBuild: starting spaCy model download ----"
date
python -m spacy download en_core_web_sm || {
	echo "postBuild: spaCy download failed with exit $?. Attempting direct pip install..."
	python -m pip install --no-cache-dir https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl || {
		echo "postBuild: direct wheel install also failed. Exiting postBuild.";
		exit 1;
	}
}
echo "---- postBuild: finished spaCy model download ----"
date
