# Example environment variables for production. Do NOT commit real secrets.
SECRET_KEY=replace_with_strong_random_value
ENV=production
# If using a managed database, set DATABASE_URL below. Example:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Example environment variables for local deployment
# Adjust values before use.

# Application
DEBUG=true
SECRET_KEY=change-me

# Optional ports (docker-compose maps these explicitly)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database (uses SQLite by default; leave empty to use default file)
# DATABASE_URL=sqlite:///./ats_database.db

# Add any cloud/API keys here
# OPENAI_API_KEY=
